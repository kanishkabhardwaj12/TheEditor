# Local, no-billing model used by both assistants.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Thermal-friendly defaults for a laptop. Increase only if the machine remains cool.
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=4096
# Serial inference is the safe default for a local 7B model.
RESEARCH_SOURCE_WORKERS=1
RESEARCH_CHUNK_WORKERS=1
RESEARCH_SUMMARY_TIMEOUT_SECONDS=360
RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=360
RESEARCH_CHUNK_CHARACTERS=3000
